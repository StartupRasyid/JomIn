generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_chat_messages {
  message_id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  session_id            String           @db.Uuid
  sender                String?          @db.VarChar(10)
  message_text          String
  recommended_event_ids String[]         @db.Uuid
  recommended_units     committee_unit[]
  timestamp             DateTime?        @default(now()) @db.Timestamptz(6)
  ai_chat_sessions      ai_chat_sessions @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_chat_sessions {
  session_id       String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String             @db.Uuid
  started_at       DateTime?          @default(now()) @db.Timestamptz(6)
  ended_at         DateTime?          @db.Timestamptz(6)
  ai_chat_messages ai_chat_messages[]
  users            users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model committee_applications {
  application_id     String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  opening_id         String              @db.Uuid
  student_id         String              @db.Uuid
  status             application_status? @default(pending)
  applied_at         DateTime?           @default(now()) @db.Timestamptz(6)
  committee_openings committee_openings  @relation(fields: [opening_id], references: [opening_id], onDelete: Cascade, onUpdate: NoAction)
  users              users               @relation(fields: [student_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([opening_id, student_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model committee_openings {
  opening_id             String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id               String                   @db.Uuid
  unit_name              committee_unit
  description            String?
  slots_available        Int?                     @default(1)
  is_open                Boolean?                 @default(true)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  committee_applications committee_applications[]
  events                 events                   @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id], map: "idx_committee_openings_event")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_analytics_logs {
  log_id         String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id       String           @db.Uuid
  user_id        String?          @db.Uuid
  sticker_id     String?          @db.Uuid
  action_type    analytics_action
  timestamp      DateTime?        @default(now()) @db.Timestamptz(6)
  events         events           @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)
  event_stickers event_stickers?  @relation(fields: [sticker_id], references: [sticker_id], onUpdate: NoAction)
  users          users?           @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([event_id, action_type], map: "idx_analytics_event_action")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_comments {
  comment_id String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id   String    @db.Uuid
  user_id    String    @db.Uuid
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  events     events    @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_interests {
  event_id    String    @db.Uuid
  interest_id String    @db.Uuid
  events      events    @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)
  interests   interests @relation(fields: [interest_id], references: [interest_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([event_id, interest_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_likes {
  user_id    String    @db.Uuid
  event_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  events     events    @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, event_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_stickers {
  sticker_id           String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id             String                 @db.Uuid
  type                 sticker_type
  label                String                 @db.VarChar(100)
  target_url           String?
  popup_content        String?
  pos_x                Float?
  pos_y                Float?
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  event_analytics_logs event_analytics_logs[]
  events               events                 @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_wishlists {
  user_id    String    @db.Uuid
  event_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  events     events    @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, event_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  event_id             String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizer_id         String                 @db.Uuid
  title                String                 @db.VarChar(150)
  description          String
  media_url            String
  media_type           media_type_enum?       @default(image)
  template_id          String?                @db.VarChar(50)
  location             String?                @db.VarChar(150)
  start_time           DateTime               @db.Timestamptz(6)
  end_time             DateTime               @db.Timestamptz(6)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  committee_openings   committee_openings[]
  event_analytics_logs event_analytics_logs[]
  event_comments       event_comments[]
  event_interests      event_interests[]
  event_likes          event_likes[]
  event_stickers       event_stickers[]
  event_wishlists      event_wishlists[]
  users                users                  @relation(fields: [organizer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizer_id], map: "idx_events_organizer")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model interests {
  interest_id       String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String              @unique @db.VarChar(50)
  event_interests   event_interests[]
  student_interests student_interests[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model student_interests {
  user_id     String    @db.Uuid
  interest_id String    @db.Uuid
  interests   interests @relation(fields: [interest_id], references: [interest_id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, interest_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model student_profiles {
  profile_id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String    @unique @db.Uuid
  bio                 String?
  personality_summary String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  users               users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  user_id                String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                  String                   @unique @db.VarChar(255)
  password_hash          String                   @db.VarChar(255)
  full_name              String                   @db.VarChar(100)
  role                   user_role?               @default(student)
  faculty                String?                  @db.VarChar(100)
  year_of_study          Int?
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @db.Timestamptz(6)
  ai_chat_sessions       ai_chat_sessions[]
  committee_applications committee_applications[]
  event_analytics_logs   event_analytics_logs[]
  event_comments         event_comments[]
  event_likes            event_likes[]
  event_wishlists        event_wishlists[]
  events                 events[]
  student_interests      student_interests[]
  student_profiles       student_profiles?
}

enum analytics_action {
  view
  like
  comment
  save
  share
  sticker_click
}

enum application_status {
  pending
  accepted
  rejected
}

enum committee_unit {
  Activity
  Multimedia
  Food
  Technical
  Protocol
  Sponsorship
}

enum media_type_enum {
  image
  video
}

enum sticker_type {
  registration_link
  speaker_bio
  product_link
  info_popup
}

enum user_role {
  student
  organizer
  admin
}
